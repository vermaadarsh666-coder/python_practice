    "end=int(input(\"enter any number:\"))\n",
    "for i in range (start,end+1):\n",
    "    if i>1:\n",
    "        for j in range (2,i):\n",
    "            if i%j==0:\n",
    "                break \n",
    "        print(i,end=\" \")"
